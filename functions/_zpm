#compdef zpm
#autoload

local _zpm_completions_plugins_local=( @zpm )
for plugin in "${_ZPM_PLUGINS_DIR}/"*; do
  _zpm_completions_plugins_local+=( ${${plugin:t}//---/\/} )
done

if [[ -e "${_ZPM_PLUGINS_DIR}/@omz" ]]; then
  for omz_plugin in "${_ZPM_PLUGINS_DIR}/@omz/plugins/"*; do
    _zpm_completions_plugins_local+=( "@omz/${omz_plugin:t}" )
  done

  for omz_lib in "${_ZPM_PLUGINS_DIR}/@omz/lib/"*; do
    _zpm_completions_plugins_local+=( "@omz/lib/${${omz_lib:t}%.zsh}" )
  done

  for omz_theme in "${_ZPM_PLUGINS_DIR}/@omz/themes/"*; do
    _zpm_completions_plugins_local+=( "@omz/theme/${${omz_theme:t}%.zsh-theme}" )
  done
fi

local _zpm_completions_plugins_installed=($(
    printf '%s\n%s\n' "${_zpm_completions_plugins_local[@]}" | sort | uniq
))

local _zpm_completions_plugins_loadable=($(
    printf '%s\n%s\n' "${_zpm_completions_plugins_installed[@]}" "${(k)_ZPM_plugins_full[@]}" | sort | uniq -u
))

local -aU _zpm_upgrade_plugins=(@zpm ${(k)_ZPM_plugins_full})

local _load_args=(
  'load:Load plugin'
  'if:Load plugin if condition true'
  'if-not:Load plugin if condition false'
)

local _zpm_all_args=(
  $_load_args
  'clean:Remove zpm cache'
  'c:Remove zpm cache'
  'upgrade:Upgrade plugin'
  'u:Upgrade plugin'
  'info:Show plugin information'
  'list:List installed plugins'
  'ls:List installed plugins'
  'readme:Show plugin README in terminal'
  'link:Link local directory or file as a plugin'
  $_zpm_extend_commands
)

local _zpm_completions_if_args=(
  'linux:Linux OS'
  'bsd:BSD OS'
  'macos:MacOS'
  'android:Android OS'
  'termux:Termux app'
  'ssh:SSH session'
  'vte:VTE based terminal emulator'
  'msys:MSYS / Windows'
  'vscode:VSCode terminal'
  'iterm:iTerm2 terminal'
)
local _zpm_loaded_plugins=(${(k)_ZPM_plugins_full})

_arguments '*:: :->subcmds' && return 0

# The subcommand follows any number of `if <cond>` / `if-not <cond>` prefixes
local -i cmd_idx=1
while [[ "$words[cmd_idx]" == (if|if-not) ]]; do
  (( cmd_idx += 2 ))
done

if (( CURRENT < cmd_idx )); then
  _describe -t commands "zpm condition" _zpm_completions_if_args
  return
fi

if (( CURRENT == cmd_idx )); then
  if (( cmd_idx == 1 )); then
    _describe -t commands "zpm subcommand" _zpm_all_args
  else
    _describe -t commands "zpm next condition" _load_args
  fi
  return
fi

local cmd="$words[cmd_idx]"
# Plugins already given on the command line are not offered again
local -a typed=( "${(@)words[cmd_idx+1,CURRENT-1]}" )
local -a candidates

case "$cmd" in
  load)
    candidates=( ${_zpm_completions_plugins_loadable:|typed} )
    _describe -t commands "zpm load" candidates
    ;;
  u|up|upgrade)
    candidates=( ${_zpm_upgrade_plugins:|typed} )
    _describe -t commands "zpm upgrade plugins" candidates
    ;;
  info|readme)
    candidates=( ${_zpm_upgrade_plugins:|typed} )
    _describe -t commands "zpm plugins" candidates
    ;;
  link)
    _files
    ;;
  c|cl|clean|list|ls)
    ;;
  *)
    if is-callable "_zpm_${cmd}_completion"; then
      "_zpm_${cmd}_completion"
    fi
    ;;
esac
